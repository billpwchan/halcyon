{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	# One JSON line per page view, so visits can be counted by the ?ref= in the uri. Addresses are dropped:
	# the peer, client and forwarded IPs and the headers that carry them never reach the log.
	log {
		output stdout
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers>Cf-Connecting-Ip delete
			request>headers>Cf-Connecting-Ipv6 delete
			request>headers>Cf-Pseudo-Ipv4 delete
			request>headers>True-Client-Ip delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			request>headers>Forwarded delete
			request>headers>Cookie delete
			request>tls delete
			resp_headers delete
		}
	}
	@notpage not path / /index.html
	log_skip @notpage
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	# Vite fingerprints the bundles; models, maps and sounds keep their names, so they revalidate hourly
	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /assets/models/* /assets/flora/* /assets/tex/* /basis/* /fonts/*
	header @media Cache-Control "public, max-age=3600"
	@ktx2 path *.ktx2
	header @ktx2 Content-Type image/ktx2
	@glb path *.glb
	header @glb Content-Type model/gltf-binary
	@html path / /index.html
	header @html Cache-Control "no-cache"
	respond /healthz "halcyon-ok" 200
	file_server
}
